{% extends 'base.html.twig' %}
{% block title %}Mon Panier — SymHome{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="section-title mb-0">Mon Panier</h2>
    {% if items|length > 0 %}
        <a href="{{ path('app_panier_clear') }}" class="btn btn-outline-danger btn-sm"
           onclick="return confirm('Vider le panier ?')">
            <i class="bi bi-trash me-1"></i> Vider le panier
        </a>
    {% endif %}
</div>

{% if items|length == 0 %}
    <div class="text-center py-5">
        <i class="bi bi-cart-x panier-empty-icon"></i>
        <h5 class="mt-3 text-muted fw-normal">Votre panier est vide</h5>
        <a href="{{ path('app_meuble') }}" class="btn btn-primary-custom mt-3 px-4">Voir nos meubles</a>
    </div>
{% else %}

<div class="row g-4">
    <div class="col-md-8">
        {% for item in items %}
        <div class="card mb-3">
            <div class="row g-0 align-items-center">
                <div class="col-3">
                    <img src="{{ asset('uploads/meubles/' ~ item.meuble.image) }}" class="panier-img" alt="{{ item.meuble.nom }}">
                </div>
                <div class="col-9">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small mb-1">{{ item.meuble.categorie ? item.meuble.categorie.libelle : '' }}</p>
                            <h6 class="fw-semibold mb-1">{{ item.meuble.nom }}</h6>
                            <p class="text-accent fw-bold mb-0">{{ item.meuble.prix }} DT / unité</p>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <form method="post" action="{{ path('app_panier_update', {id: item.meuble.id}) }}"
                                  class="d-flex align-items-center gap-2 panier-update-form">
                                <input type="number" name="quantite" value="{{ item.quantite }}"
                                       min="1" max="{{ item.meuble.stock }}"
                                       class="form-control form-control-sm quantite-input"
                                       data-prix="{{ item.meuble.prix }}"
                                       data-max="{{ item.meuble.stock }}">
                            </form>
                            <span class="fw-bold sous-total-display">{{ item.sousTotal }} DT</span>
                            <a href="{{ path('app_panier_remove', {id: item.meuble.id}) }}"
                               class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    <div class="col-md-4">
        <div class="recap-card card p-4">
            <h5 class="fw-semibold mb-3">Récapitulatif</h5>
            <div class="d-flex justify-content-between text-muted mb-2">
                <span>Articles</span>
                <span>{{ items|length }}</span>
            </div>
            <div class="d-flex justify-content-between text-muted mb-3">
                <span>Livraison</span>
                <span class="text-success">Gratuite</span>
            </div>
            <hr>
            <div class="d-flex justify-content-between mb-4">
                <strong class="fs-6">Total</strong>
                <strong class="text-accent fs-5">{{ total }} DT</strong>
            </div>
            <a href="{{ path('app_paiement') }}" class="btn btn-primary-custom w-100 btn-lg mb-2">
                <i class="bi bi-credit-card me-1"></i> Passer la commande
            </a>
            <a href="{{ path('app_meuble') }}" class="btn btn-outline-secondary w-100">
                Continuer mes achats
            </a>
        </div>
    </div>
</div>

{% endif %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const totalDisplay = document.querySelector('.text-accent.fs-5');

    function updateTotals() {
        let grandTotal = 0;

        document.querySelectorAll('.quantite-input').forEach(function (input) {
            const prix = parseFloat(input.dataset.prix);
            const max = parseInt(input.dataset.max);
            let qty = parseInt(input.value) || 1;

            if (qty < 1) qty = 1;
            if (qty > max) qty = max;
            input.value = qty;

            const sousTotal = prix * qty;
            grandTotal += sousTotal;

            const card = input.closest('.card');
            if (card) {
                const sousTotalEl = card.querySelector('.sous-total-display');
                if (sousTotalEl) sousTotalEl.textContent = sousTotal.toFixed(0) + ' DT';
            }
        });

        if (totalDisplay) {
            totalDisplay.textContent = grandTotal.toFixed(0) + ' DT';
        }
    }

    document.querySelectorAll('.quantite-input').forEach(function (input) {
        input.addEventListener('input', updateTotals);
        input.addEventListener('change', function () {
            clearTimeout(input._debounce);
            input._debounce = setTimeout(function () {
                input.closest('.panier-update-form').submit();
            }, 800);
        });
    });
});
</script>
{% endblock %}

{% endblock %}