{% extends 'base.html.twig' %}
{% block title %}Mon Panier — SymHome{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Mon Panier</h2>
    {% if items|length > 0 %}
        <a href="{{ path('app_panier_clear') }}" class="btn btn-outline-danger btn-sm"
           onclick="return confirm('Vider le panier ?')">
            <i class="bi bi-trash"></i> Vider le panier
        </a>
    {% endif %}
</div>

{% if items|length == 0 %}
    <div class="text-center py-5">
        <i class="bi bi-cart-x panier-empty-icon"></i>
        <h4 class="mt-3 text-muted">Votre panier est vide</h4>
        <a href="{{ path('app_meuble') }}" class="btn btn-primary-custom mt-3">Voir nos meubles</a>
    </div>
{% else %}

<div class="row g-4">
    <div class="col-md-8">
        {% for item in items %}
        <div class="card mb-3">
            <div class="row g-0 align-items-center">
                <div class="col-3">
                    <img src="{{ item.meuble.image }}" class="panier-img rounded-start" alt="{{ item.meuble.nom }}">
                </div>
                <div class="col-9">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">{{ item.meuble.nom }}</h6>
                            <p class="text-muted small mb-1">{{ item.meuble.categorie ? item.meuble.categorie.libelle : '' }}</p>
                            <p class="text-accent fw-bold mb-0">{{ item.meuble.prix }} DT / unité</p>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <form method="post" action="{{ path('app_panier_update', {id: item.meuble.id}) }}"
                                  class="d-flex align-items-center gap-2">
                                <input type="number" name="quantite" value="{{ item.quantite }}"
                                       min="1" max="{{ item.meuble.stock }}"
                                       class="form-control form-control-sm quantite-input">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-arrow-clockwise"></i>
                                </button>
                            </form>
                            <span class="fw-bold">{{ item.sousTotal }} DT</span>
                            <a href="{{ path('app_panier_remove', {id: item.meuble.id}) }}" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    <div class="col-md-4">
        <div class="card p-4">
            <h5 class="mb-3">Récapitulatif</h5>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Articles</span>
                <span>{{ items|length }}</span>
            </div>
            <hr>
            <div class="d-flex justify-content-between mb-3">
                <strong>Total</strong>
                <strong class="text-accent fs-5">{{ total }} DT</strong>
            </div>
            <a href="" class="btn btn-primary-custom w-100 btn-lg">
                <i class="bi bi-credit-card"></i> Passer la commande
            </a>
            <a href="{{ path('app_meuble') }}" class="btn btn-outline-secondary w-100 mt-2">← Continuer mes achats</a>
        </div>
    </div>
</div>

{% endif %}

{% endblock %}