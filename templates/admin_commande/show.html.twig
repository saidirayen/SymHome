{% extends 'admin/base_admin.html.twig' %}

{% block title %}Commande {{ commande.reference }} — Admin{% endblock %}
{% block page_title %}Informations sur la commande{% endblock %}

{% block body %}
<div class="row g-4">
    <div class="col-md-4">
        <div class="admin-card mb-3">
            <div class="admin-card-header">Informations</div>
            <div class="admin-card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Référence</dt><dd class="col-7 font-monospace">{{ commande.reference }}</dd>
                    <dt class="col-5">Date</dt><dd class="col-7">{{ commande.dateCreation|date('d/m/Y H:i') }}</dd>
                    <dt class="col-5">Total</dt><dd class="col-7 fw-bold">{{ commande.total|number_format(2, ',', ' ') }} TND</dd>
                    <dt class="col-5">Client</dt>
                    <dd class="col-7">
                        {% if commande.user %}
                            {{ commande.user.prenom }} {{ commande.user.nom }}<br>
                            <small class="text-muted">{{ commande.user.email }}</small>
                        {% else %}—{% endif %}
                    </dd>
                </dl>
            </div>
        </div>

        <div class="admin-card">
            <div class="admin-card-header">Changer le statut</div>
            <div class="admin-card-body">
                <form method="post" action="{{ path('admin_commande_statut', {'id': commande.id}) }}">
                    <select name="statut" class="form-select mb-2">
                        <option value="en_attente"  {{ commande.statut == 'en_attente'  ? 'selected' : '' }}>En attente</option>
                        <option value="en_cours"    {{ commande.statut == 'en_cours'    ? 'selected' : '' }}>En cours</option>
                        <option value="completee"   {{ commande.statut == 'completee'   ? 'selected' : '' }}>Complétée</option>
                        <option value="annulee"     {{ commande.statut == 'annulee'     ? 'selected' : '' }}>Annulée</option>
                    </select>
                    <button type="submit" class="btn btn-accent w-100">Mettre à jour</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="admin-card">
            <div class="admin-card-header">Lignes de commande</div>
            <div class="admin-card-body p-0">
                <table class="table mb-0">
                    <thead class="table-light">
                        <tr><th>Meuble</th><th>Qté</th><th>Prix unitaire</th><th>Sous-total</th></tr>
                    </thead>
                    <tbody>
                        {% for ligne in commande.ligneCommandes %}
                            <tr>
                                <td>{{ ligne.meuble ? ligne.meuble.nom : '—' }}</td>
                                <td>{{ ligne.quantite }}</td>
                                <td>{{ ligne.prixUnitaire|number_format(2, ',', ' ') }} TND</td>
                                <td>{{ (ligne.quantite * ligne.prixUnitaire)|number_format(2, ',', ' ') }} TND</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="4" class="text-muted text-center py-3">Aucune ligne.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <a href="{{ path('admin_commande_index') }}" class="btn btn-outline-secondary">Retour</a>
            <form method="post" action="{{ path('admin_commande_delete', {'id': commande.id}) }}"
                  onsubmit="return confirm('Supprimer cette commande ?')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ commande.id) }}">
                <button class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i> Supprimer</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
