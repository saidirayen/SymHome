{% extends 'admin/base_admin.html.twig' %}

{% block title %}Commandes — Admin{% endblock %}
{% block page_title %}Suivi des Commandes{% endblock %}

{% block body %}
<div class="admin-card">
    <div class="admin-card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Référence</th>
                    <th>Client</th>
                    <th>Date</th>
                    <th>Total</th>
                    <th>Statut</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for commande in commandes %}
                    <tr>
                        <td class="fw-semibold font-monospace">{{ commande.reference }}</td>
                        <td>
                            {% if commande.user %}
                                {{ commande.user.prenom }} {{ commande.user.nom }}
                                <div class="text-muted small">{{ commande.user.email }}</div>
                            {% else %}—{% endif %}
                        </td>
                        <td class="small">{{ commande.dateCreation|date('d/m/Y H:i') }}</td>
                        <td>{{ commande.total|number_format(2, ',', ' ') }} TND</td>
                        <td>
                            {% set s = commande.statut %}
                            <span class="badge statut-{{ s }}">
                                {{ s == 'en_attente' ? 'En attente' : (s == 'en_cours' ? 'En cours' : (s == 'completee' ? 'Complétée' : 'Annulée')) }}
                            </span>
                        </td>
                        <td class="text-end">
                            <a href="{{ path('admin_commande_show', {'id': commande.id}) }}" class="btn btn-sm btn-outline-secondary">
                                Voir
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="text-center text-muted py-4">Aucune commande.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
