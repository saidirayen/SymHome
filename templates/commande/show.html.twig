{% extends 'base.html.twig' %}
{% block title %}Commande {{ commande.reference }} — SymHome{% endblock %}

{% block body %}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="{{ path('app_home') }}" class="text-accent">
                Accueil
            </a>
        </li>

        <li class="breadcrumb-item">
            <a href="{{ path('app_commande_historique') }}" class="text-accent">
                Mes commandes
            </a>
        </li>

        <li class="breadcrumb-item active">
            {{ commande.reference }}
        </li>
    </ol>
</nav>

<div class="row g-4">

    <div class="col-md-8">

        <div class="commande-card card p-4 mb-3">

            <h5 class="fw-semibold mb-3">
                Articles commandés
            </h5>

            {% for ligne in commande.ligneCommandes %}

                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">

                    <div class="d-flex align-items-center gap-3">

                        {% if ligne.meuble.image %}
                            <img src="{{ asset('uploads/meubles/' ~ ligne.meuble.image) }}"
                                 style="width:60px; height:60px; object-fit:cover; border-radius:6px;">
                        {% endif %}

                        <div>
                            <p class="fw-semibold mb-0">
                                {{ ligne.meuble.nom }}
                            </p>

                            <p class="text-muted small mb-0">
                                {{ ligne.prixUnitaire }} DT × {{ ligne.quantite }}
                            </p>
                        </div>

                    </div>

                    <strong class="text-accent">
                        {{ ligne.prixUnitaire * ligne.quantite }} DT
                    </strong>

                </div>

            {% endfor %}

        </div>

    </div>

    <div class="col-md-4">

        <div class="recap-card card p-4">

            <h5 class="fw-semibold mb-3">
                Détails de la commande
            </h5>

            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Référence</span>

                <span class="fw-semibold">
                    {{ commande.reference }}
                </span>
            </div>

            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Date</span>

                <span>
                    {{ commande.dateCreation|date('d/m/Y à H:i') }}
                </span>
            </div>

            <div class="d-flex justify-content-between mb-3">

                <span class="text-muted">Statut</span>

                <span class="statut-badge
                    {% if commande.statut == 'en_attente' %}
                        bg-warning text-dark
                    {% elseif commande.statut == 'en_cours' %}
                        bg-primary text-white
                    {% elseif commande.statut == 'completee' %}
                        bg-success text-white
                    {% else %}
                        bg-secondary text-white
                    {% endif %}
                ">
                    {{ commande.statut|replace({'_': ' '})|capitalize }}
                </span>

            </div>

            <hr>

            <div class="d-flex justify-content-between">
                <strong>Total</strong>

                <strong class="text-accent fs-5">
                    {{ commande.total }} DT
                </strong>
            </div>

            <a href="{{ path('app_commande_historique') }}"
               class="btn btn-outline-secondary w-100 mt-3">
                Retour à mes commandes
            </a>

        </div>

    </div>

</div>

{% endblock %}