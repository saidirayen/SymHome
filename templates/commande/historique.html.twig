{% extends 'base.html.twig' %}
{% block title %}Mes commandes — SymHome{% endblock %}

{% block body %}

<h2 class="section-title">Mes commandes</h2>

{% if commandes|length == 0 %}
    <div class="text-center py-5">
        <i class="bi bi-bag-x fs-1 text-muted"></i>
        <h5 class="mt-3 text-muted fw-normal">
            Vous n'avez pas encore de commandes
        </h5>

        <a href="{{ path('app_meuble') }}"
           class="btn btn-primary-custom mt-3 px-4">
            Découvrir nos meubles
        </a>
    </div>
{% else %}

    {% for commande in commandes %}
        <div class="commande-card card mb-3 p-3">
            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h6 class="fw-semibold mb-1">
                        {{ commande.reference }}
                    </h6>

                    <p class="text-muted small mb-0">
                        {{ commande.dateCreation|date('d/m/Y à H:i') }}
                    </p>
                </div>

                <div class="d-flex align-items-center gap-3">

                    <span class="statut-badge
                        {% if commande.statut == 'en_attente' %}
                            bg-warning text-dark
                        {% elseif commande.statut == 'en_cours' %}
                            bg-info text-white
                        {% elseif commande.statut == 'completee' %}
                            bg-success text-white
                        {% else %}
                            bg-secondary text-white
                        {% endif %}
                    ">
                        {{ commande.statut|replace({'_': ' '})|capitalize }}
                    </span>

                    <strong class="text-accent">
                        {{ commande.total }} DT
                    </strong>

                    <a href="{{ path('app_commande_show', {id: commande.id}) }}"
                       class="btn btn-sm btn-outline-secondary">
                        Détail
                    </a>

                </div>

            </div>
        </div>
    {% endfor %}

{% endif %}

{% endblock %}