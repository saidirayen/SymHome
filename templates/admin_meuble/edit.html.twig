{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier — {{ meuble.nom }} — Admin{% endblock %}
{% block page_title %}Modifier : {{ meuble.nom }}{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="admin-card">
            <div class="admin-card-header">Modifier le meuble</div>
            <div class="admin-card-body">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                <div class="row g-3">
                    <div class="col-md-8">{{ form_row(form.nom) }}</div>
                    <div class="col-md-4">{{ form_row(form.slug) }}</div>
                    <div class="col-12">{{ form_row(form.description) }}</div>
                    <div class="col-md-4">{{ form_row(form.prix) }}</div>
                    <div class="col-md-4">{{ form_row(form.stock) }}</div>
                    <div class="col-md-4">{{ form_row(form.categorie) }}</div>
                    <div class="col-12">{{ form_row(form.image) }}</div>
                    {% if meuble.image %}
                        <div class="col-12">
                            <img src="{{ meuble.image }}" alt="Aperçu actuel"
                                 style="max-height:180px; border-radius:8px;">
                        </div>
                    {% endif %}
                </div>
                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-accent">
                        <i class="bi bi-check-lg me-1"></i> Enregistrer
                    </button>
                    <a href="{{ path('admin_meuble_index') }}" class="btn btn-outline-secondary">Annuler</a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>

        <div class="mt-3">
            <form method="post" action="{{ path('admin_meuble_delete', {'id': meuble.id}) }}"
                  onsubmit="return confirm('Supprimer définitivement ce meuble ?')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ meuble.id) }}">
                <button class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-trash me-1"></i> Supprimer
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
