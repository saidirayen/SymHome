{% extends 'admin/base_admin.html.twig' %}

{% block title %}Nouveau Meuble — Admin{% endblock %}
{% block page_title %}Ajouter un Meuble{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="admin-card">
            <div class="admin-card-header">Informations du meuble</div>
            <div class="admin-card-body">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                <div class="row g-3">
                    <div class="col-md-8">{{ form_row(form.nom) }}</div>
                    <div class="col-md-4">{{ form_row(form.slug) }}</div>
                    <div class="col-12">{{ form_row(form.description) }}</div>
                    <div class="col-md-4">{{ form_row(form.prix) }}</div>
                    <div class="col-md-4">{{ form_row(form.stock) }}</div>
                    <div class="col-md-4">{{ form_row(form.categorie) }}</div>
                    <div class="col-12">{{ form_row(form.image) }}</div>
                    {% if form.image.vars.value %}
                        <div class="col-12">
                            <img src="{{ form.image.vars.value }}" alt="Aperçu" style="max-height:180px; border-radius:8px;">
                        </div>
                    {% endif %}
                </div>
                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-accent"><i class="bi bi-check-lg me-1"></i> Enregistrer</button>
                    <a href="{{ path('admin_meuble_index') }}" class="btn btn-outline-secondary">Annuler</a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
