{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ meuble.nom }} — Admin{% endblock %}
{% block page_title %}{{ meuble.nom }}{% endblock %}

{% block body %}
<div class="row g-4">
    <div class="col-md-5">
        {% if meuble.image %}
            <img src="{{ meuble.image }}" alt="{{ meuble.nom }}" class="w-100 rounded-3">
        {% else %}
            <div class="admin-thumb-placeholder w-100" style="height:280px;font-size:3rem;"><i class="bi bi-image"></i></div>
        {% endif %}
    </div>
    <div class="col-md-7">
        <div class="admin-card h-100">
            <div class="admin-card-body">
                <dl class="row">
                    <dt class="col-sm-4">ID</dt><dd class="col-sm-8">{{ meuble.id }}</dd>
                    <dt class="col-sm-4">Nom</dt><dd class="col-sm-8">{{ meuble.nom }}</dd>
                    <dt class="col-sm-4">Slug</dt><dd class="col-sm-8"><code>{{ meuble.slug }}</code></dd>
                    <dt class="col-sm-4">Catégorie</dt><dd class="col-sm-8">{{ meuble.categorie ? meuble.categorie.libelle : '—' }}</dd>
                    <dt class="col-sm-4">Prix</dt><dd class="col-sm-8">{{ meuble.prix|number_format(2, ',', ' ') }} TND</dd>
                    <dt class="col-sm-4">Stock</dt><dd class="col-sm-8">{{ meuble.stock }}</dd>
                    <dt class="col-sm-4">Description</dt><dd class="col-sm-8">{{ meuble.description ?? '—' }}</dd>
                </dl>
                <div class="d-flex gap-2 mt-3">
                    <a href="{{ path('admin_meuble_edit', {'id': meuble.id}) }}" class="btn btn-accent">
                        <i class="bi bi-pencil me-1"></i> Modifier
                    </a>
                    <a href="{{ path('admin_meuble_index') }}" class="btn btn-outline-secondary">Retour</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
