{% extends 'base.html.twig' %}
{% block title %}Paiement — SymHome{% endblock %}

{% block body %}

<h2 class="section-title mb-4">Paiement</h2>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card p-4">

            {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'paiement-form'}}) }}

            <div class="mb-3">
                {{ form_label(form.moyenPaiement, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                {{ form_widget(form.moyenPaiement, {'attr': {'class': 'form-select' ~ (form.moyenPaiement.vars.errors|length ? ' is-invalid' : '')}}) }}
                {{ form_errors(form.moyenPaiement) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.numeroCarte, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                {{ form_widget(form.numeroCarte, {'attr': {'class': 'form-control' ~ (form.numeroCarte.vars.errors|length ? ' is-invalid' : '')}}) }}
                {{ form_errors(form.numeroCarte) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.nomPorteur, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                {{ form_widget(form.nomPorteur, {'attr': {'class': 'form-control' ~ (form.nomPorteur.vars.errors|length ? ' is-invalid' : '')}}) }}
                {{ form_errors(form.nomPorteur) }}
            </div>

            <div class="row g-3 mb-4">
                <div class="col-6">
                    {{ form_label(form.dateExpiration, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.dateExpiration, {'attr': {'class': 'form-control' ~ (form.dateExpiration.vars.errors|length ? ' is-invalid' : '')}}) }}
                    {{ form_errors(form.dateExpiration) }}
                </div>
                <div class="col-6">
                    {{ form_label(form.codeCvv, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                    {{ form_widget(form.codeCvv, {'attr': {'class': 'form-control' ~ (form.codeCvv.vars.errors|length ? ' is-invalid' : '')}}) }}
                    {{ form_errors(form.codeCvv) }}
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <strong>Total à payer</strong>
                <strong class="text-accent fs-5">{{ total }} DT</strong>
            </div>

            <button type="submit" class="btn btn-primary-custom w-100 btn-lg">
                <i class="bi bi-lock-fill me-2"></i> Confirmer le paiement
            </button>

            {{ form_end(form) }}

        </div>
    </div>
</div>

{% endblock %}
