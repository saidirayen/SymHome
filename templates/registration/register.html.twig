<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Inscription — SymHome</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link href="{{ asset('styles/app.css') }}" rel="stylesheet">
</head>
<body class="auth-page">

<div class="auth-wrapper">
    <div class="auth-left">
        <div class="auth-left-content">
            <h1 class="auth-brand">SymHome</h1>
            <p class="auth-tagline">Rejoignez notre communauté et découvrez nos collections exclusives.</p>
            <ul class="auth-features">
                <li><i class="bi bi-check-circle-fill"></i> Compte gratuit</li>
                <li><i class="bi bi-check-circle-fill"></i> Suivi de vos commandes</li>
                <li><i class="bi bi-check-circle-fill"></i> Historique d'achats</li>
                <li><i class="bi bi-check-circle-fill"></i> Offres exclusives</li>
            </ul>
        </div>
    </div>

    <div class="auth-right">
        <div class="auth-form-box">
            <h3 class="auth-form-title">Créer un compte</h3>
            <p class="auth-form-subtitle">Rejoignez SymHome en quelques secondes</p>

            {{ form_errors(registrationForm) }}
            {{ form_start(registrationForm) }}

            <div class="row">
                <div class="col-md-6 mb-3">{{ form_row(registrationForm.nom) }}</div>
                <div class="col-md-6 mb-3">{{ form_row(registrationForm.prenom) }}</div>
            </div>
            <div class="mb-3">{{ form_row(registrationForm.email) }}</div>
            <div class="mb-3">{{ form_row(registrationForm.telephone) }}</div>
            <div class="mb-3">{{ form_row(registrationForm.plainPassword) }}</div>
            <div class="mb-4">{{ form_row(registrationForm.agreeTerms) }}</div>

            <button type="submit" class="btn btn-primary-custom w-100 btn-lg">Créer mon compte</button>

            {{ form_end(registrationForm) }}

            <div class="auth-divider"><span>ou</span></div>

            <p class="text-center mb-0">
                Déjà un compte ?
                <a href="{{ path('app_login') }}" class="text-accent fw-semibold">Se connecter</a>
            </p>
        </div>
    </div>
</div>

</body>
</html>