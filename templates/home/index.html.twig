{% extends 'base.html.twig' %}
{% block title %}SymHome{% endblock %}

{% block body %}

<div class="p-5 mb-4 rounded-3 text-white hero">
    <div class="container-fluid py-3">
        <h1 class="display-5 fw-bold hero-title">Bienvenue chez SymHome</h1>
        <p class="col-md-8 fs-5">Découvrez notre collection de meubles et décorations pour chaque pièce de votre maison.</p>
        <a href="{{ path('app_meuble') }}" class="btn btn-lg btn-primary-custom">Voir nos meubles</a>
    </div>
</div>

<h2 class="mb-3">Nos catégories</h2>
<div class="row g-3 mb-5">
    {% for categorie in categories %}
    <div class="col-6 col-md-3">
        <a href="{{ path('app_meuble', {categorie: categorie.id}) }}" class="text-decoration-none">
            <div class="card text-center h-100 py-3">
                <div class="card-body">
                    <i class="bi bi-grid fs-1 text-accent"></i>
                    <h5 class="card-title mt-2">{{ categorie.libelle }}</h5>
                </div>
            </div>
        </a>
    </div>
    {% else %}
    <p class="text-muted">Aucune catégorie disponible.</p>
    {% endfor %}
</div>

<h2 class="mb-3">Nouveautés</h2>
<div class="row g-3">
    {% for meuble in meubles %}
    <div class="col-6 col-md-3">
        <div class="card h-100">
            {% if meuble.image %}
                <img src="{{ meuble.image }}" class="card-img-top" alt="{{ meuble.nom }}">
            {% else %}
                <div class="card-img-placeholder bg-secondary text-white">
                    <i class="bi bi-image fs-1"></i>
                </div>
            {% endif %}
            <div class="card-body d-flex flex-column">
                <h6 class="card-title">{{ meuble.nom }}</h6>
                <p class="text-muted small">{{ meuble.categorie ? meuble.categorie.libelle : '' }}</p>
                <p class="fw-bold mt-auto text-accent">{{ meuble.prix }} DT</p>
            <div class="mt-auto d-flex gap-2">
                <a href="{{ path('app_meuble_show', {id: meuble.id}) }}" class="btn btn-sm btn-outline-secondary flex-fill">Voir détail</a>
                <a href="{{ path('app_panier_add', {id: meuble.id}) }}" class="btn btn-sm btn-primary-custom flex-fill">
                    <i class="bi bi-cart-plus"></i>
                </a>
            </div>            
            </div>
        </div>
    </div>
    {% else %}
    <p class="text-muted">Aucun meuble disponible.</p>
    {% endfor %}
</div>

{% endblock %}