{% extends 'base.html.twig' %}
{% block title %}SymHome — Mobilier & Décoration{% endblock %}

{% block body %}

<div class="hero text-white mb-5">
    <h1 class="display-5 fw-bold hero-title mb-3">Bienvenue chez SymHome</h1>
    <p class="fs-5 mb-4" style="color: #BDC3C7; max-width: 560px;">
        Découvrez notre collection de meubles et décorations pour chaque pièce de votre maison.
    </p>
    <a href="{{ path('app_meuble') }}" class="btn btn-primary-custom btn-lg px-4">Voir nos meubles</a>
</div>

<h2 class="section-title">Nos catégories</h2>
<div class="row g-3 mb-5">
    {% for categorie in categories %}
    <div class="col-6 col-md-3">
        <a href="{{ path('app_meuble', {categorie: categorie.id}) }}" class="text-decoration-none">
            <div class="card cat-card text-center h-100 py-4">
                <div class="card-body">
                    <div class="cat-icon mb-2">
                        {% if categorie.libelle == 'Séjour' %}<i class="bi bi-tv"></i>
                        {% elseif categorie.libelle == 'Chambre' %}<i class="bi bi-moon"></i>
                        {% elseif categorie.libelle == 'Bureau' %}<i class="bi bi-briefcase"></i>
                        {% elseif categorie.libelle == 'Cuisine' %}<i class="bi bi-cup-hot"></i>
                        {% else %}<i class="bi bi-grid"></i>{% endif %}
                    </div>
                    <h6 class="fw-semibold mb-0">{{ categorie.libelle }}</h6>
                </div>
            </div>
        </a>
    </div>
    {% else %}
    <p class="text-muted">Aucune catégorie disponible.</p>
    {% endfor %}
</div>

<h2 class="section-title">Nouveautés</h2>
<div class="row g-3">
    {% for meuble in meubles %}
    <div class="col-6 col-md-3">
        <div class="card h-100">
            {% if meuble.image %}
                <img src="{{ meuble.image }}" class="card-img-top" alt="{{ meuble.nom }}">
            {% else %}
                <div class="card-img-placeholder bg-light">
                    <i class="bi bi-image fs-1 text-muted"></i>
                </div>
            {% endif %}
            <div class="card-body d-flex flex-column">
                <p class="text-muted small mb-1">{{ meuble.categorie ? meuble.categorie.libelle : '' }}</p>
                <h6 class="card-title">{{ meuble.nom }}</h6>
                <p class="fw-bold mt-auto text-accent mb-2">{{ meuble.prix }} DT</p>
                <div class="d-flex gap-2">
                    <a href="{{ path('app_meuble_show', {id: meuble.id}) }}" class="btn btn-sm btn-outline-secondary flex-fill">Détail</a>
                    <a href="{{ path('app_panier_add', {id: meuble.id}) }}" class="btn btn-sm btn-primary-custom flex-fill">
                        <i class="bi bi-cart-plus"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
    {% else %}
    <p class="text-muted">Aucun meuble disponible.</p>
    {% endfor %}
</div>

{% endblock %}