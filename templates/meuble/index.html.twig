{% extends 'base.html.twig' %}
{% block title %}Nos Meubles — SymHome{% endblock %}

{% block body %}

<h2 class="mb-4">Nos Meubles</h2>

<form method="GET" action="{{ path('app_meuble') }}" class="row g-2 mb-4">
    <div class="col-md-6">
        <input type="text" name="search" class="form-control" placeholder="Rechercher un meuble..." value="{{ search }}">
    </div>
    <div class="col-md-4">
        <select name="categorie" class="form-select">
            <option value="">Toutes les catégories</option>
            {% for cat in categories %}
                <option value="{{ cat.id }}" {{ categorieId == cat.id ? 'selected' : '' }}>{{ cat.libelle }}</option>
            {% endfor %}
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary-custom w-100">Filtrer</button>
    </div>
</form>

<div class="row g-3">
    {% for meuble in meubles %}
    <div class="col-6 col-md-3">
        <div class="card h-100">
            {% if meuble.image %}
                <img src="{{ meuble.image }}" class="card-img-top" alt="{{ meuble.nom }}">
            {% else %}
                <div class="card-img-placeholder bg-secondary text-white">
                    <i class="bi bi-image fs-1"></i>
                </div>
            {% endif %}
            <div class="card-body d-flex flex-column">
                <h6 class="card-title">{{ meuble.nom }}</h6>
                <p class="text-muted small mb-1">{{ meuble.categorie ? meuble.categorie.libelle : 'Sans catégorie' }}</p>
                <p class="fw-bold text-accent">{{ meuble.prix }} DT</p>
                <div class="mt-auto d-flex gap-2">
                    <a href="{{ path('app_meuble_show', {id: meuble.id}) }}" class="btn btn-sm btn-outline-secondary flex-fill">Voir détail</a>
                    <a href="{{ path('app_panier_add', {id: meuble.id}) }}" class="btn btn-sm btn-primary-custom flex-fill">                        <i class="bi bi-cart-plus"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
    {% else %}
    <div class="col-12"><p class="text-muted">Aucun meuble trouvé.</p></div>
    {% endfor %}
</div>

{% endblock %}