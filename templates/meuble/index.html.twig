{% extends 'base.html.twig' %}
{% block title %}Nos Meubles — SymHome{% endblock %}

{% block body %}

<h2 class="section-title">Nos Meubles</h2>

<div class="filter-card">
    <form method="GET" action="{{ path('app_meuble') }}" class="row g-3 align-items-end">
        <div class="col-md-6">
            <label class="form-label">Rechercher</label>
            <input type="text" name="search" class="form-control"
                   placeholder="Nom du meuble..." value="{{ search }}">
        </div>
        <div class="col-md-4">
            <label class="form-label">Catégorie</label>
            <select name="categorie" class="form-select">
                <option value="">Toutes les catégories</option>
                {% for cat in categories %}
                    <option value="{{ cat.id }}" {{ categorieId == cat.id ? 'selected' : '' }}>
                        {{ cat.libelle }}
                    </option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary-custom w-100" style="border-radius:50px;">
                <i class="bi bi-search me-1"></i> Filtrer
            </button>
        </div>
    </form>
</div>

<div class="row g-3">
    {% for meuble in meubles %}
    <div class="col-6 col-md-3">
        <div class="card h-100 {{ meuble.stock == 0 ? 'card-out-of-stock' : '' }}">
            <div class="position-relative">
                {% if meuble.image %}
                    <img src="{{ meuble.image }}" class="card-img-top" alt="{{ meuble.nom }}">
                {% else %}
                    <div class="card-img-placeholder">
                        <i class="bi bi-image"></i>
                    </div>
                {% endif %}
                {% if meuble.stock == 0 %}
                    <span class="stock-badge stock-badge--out">Hors stock</span>
                {% elseif meuble.stock != 0 %}
                    <span class="stock-badge stock-badge--low">{{ meuble.stock }} en stock</span>
                {% endif %}
            </div>
            <div class="card-body d-flex flex-column">
                <p class="text-muted small mb-1">{{ meuble.categorie ? meuble.categorie.libelle : 'Sans catégorie' }}</p>
                <h6 class="card-title">{{ meuble.nom }}</h6>
                <p class="fw-bold text-accent mb-3 mt-auto">{{ meuble.prix }} DT</p>
                <div class="d-flex gap-2">
                    <a href="{{ path('app_meuble_show', {id: meuble.id}) }}"
                       class="btn btn-sm btn-outline-secondary flex-fill">Détail</a>
                    {% if meuble.stock > 0 %}
                        <a href="{{ path('app_panier_add', {id: meuble.id}) }}"
                           class="btn btn-sm btn-primary-custom flex-fill">
                            <i class="bi bi-bag-plus"></i>
                        </a>
                    {% else %}
                        <button class="btn btn-sm btn-outline-secondary flex-fill" disabled>
                            <i class="bi bi-bag-x"></i>
                        </button>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    {% else %}
    <div class="col-12">
        <div class="text-center py-5">
            <i class="bi bi-search fs-1" style="color:#D9D9D9;"></i>
            <p class="mt-3" style="color:#8A7968;">Aucun meuble trouvé.</p>
        </div>
    </div>
    {% endfor %}
</div>

{% endblock %}
