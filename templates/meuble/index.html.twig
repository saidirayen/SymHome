{% extends 'base.html.twig' %}
{% block title %}Nos Meubles — SymHome{% endblock %}

{% block body %}

<h2 class="section-title">Nos Meubles</h2>

<div class="card p-3 mb-4">
    <form method="GET" action="{{ path('app_meuble') }}" class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label small text-muted mb-1">Rechercher</label>
            <input type="text" name="search" class="form-control" placeholder="Nom du meuble..." value="{{ search }}">
        </div>
        <div class="col-md-4">
            <label class="form-label small text-muted mb-1">Catégorie</label>
            <select name="categorie" class="form-select">
                <option value="">Toutes les catégories</option>
                {% for cat in categories %}
                    <option value="{{ cat.id }}" {{ categorieId == cat.id ? 'selected' : '' }}>{{ cat.libelle }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary-custom w-100">Filtrer</button>
        </div>
    </form>
</div>

<div class="row g-3">
    {% for meuble in meubles %}
    <div class="col-6 col-md-3">
        <div class="card h-100">
            {% if meuble.image %}
                <img src="{{ meuble.image }}" class="card-img-top" alt="{{ meuble.nom }}">
            {% else %}
                <div class="card-img-placeholder bg-light">
                    <i class="bi bi-image fs-1 text-muted"></i>
                </div>
            {% endif %}
            <div class="card-body d-flex flex-column">
                <p class="text-muted small mb-1">{{ meuble.categorie ? meuble.categorie.libelle : 'Sans catégorie' }}</p>
                <h6 class="card-title">{{ meuble.nom }}</h6>
                <p class="fw-bold text-accent mb-2">{{ meuble.prix }} DT</p>
                <div class="mt-auto d-flex gap-2">
                    <a href="{{ path('app_meuble_show', {id: meuble.id}) }}" class="btn btn-sm btn-outline-secondary flex-fill">Détail</a>
                    <a href="{{ path('app_panier_add', {id: meuble.id}) }}" class="btn btn-sm btn-primary-custom flex-fill">
                        <i class="bi bi-cart-plus"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
    {% else %}
    <div class="col-12">
        <div class="text-center py-5">
            <i class="bi bi-search fs-1 text-muted"></i>
            <p class="text-muted mt-2">Aucun meuble trouvé.</p>
        </div>
    </div>
    {% endfor %}
</div>

{% endblock %}