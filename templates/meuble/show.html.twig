{% extends 'base.html.twig' %}
{% block title %}{{ meuble.nom }} — SymHome{% endblock %}

{% block body %}

<div class="row">
    <div class="col-md-5">
        {% if meuble.image %}
            <img src="{{ meuble.image) }}" class="img-fluid rounded" alt="{{ meuble.nom }}">
        {% else %}
            <div class="card-img-placeholder show-img-placeholder bg-secondary text-white rounded">
                <i class="bi bi-image fs-1"></i>
            </div>
        {% endif %}
    </div>

    <div class="col-md-7">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_meuble') }}">Meubles</a></li>
                <li class="breadcrumb-item active">{{ meuble.nom }}</li>
            </ol>
        </nav>

        <h2>{{ meuble.nom }}</h2>
        <p class="text-muted">Catégorie : <strong>{{ meuble.categorie ? meuble.categorie.libelle : 'N/A' }}</strong></p>
        <h3 class="text-accent">{{ meuble.prix }} DT</h3>
        <p class="mt-3">{{ meuble.description }}</p>
        <p class="mt-2">
            {% if meuble.stock > 0 %}
                <span class="badge bg-success">En stock ({{ meuble.stock }} disponibles)</span>
            {% else %}
                <span class="badge bg-danger">Rupture de stock</span>
            {% endif %}
        </p>
        <div class="mt-4 d-flex gap-3">
            {% if meuble.stock > 0 %}
                <a href="{{ path('app_panier_add', {id: meuble.id}) }}" class="btn btn-primary-custom px-4">
                    <i class="bi bi-cart-plus"></i> Ajouter au panier
                </a>
            {% endif %}
            <a href="{{ path('app_meuble') }}" class="btn btn-outline-secondary">← Retour</a>
        </div>
    </div>
</div>

{% endblock %}