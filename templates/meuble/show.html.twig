{% extends 'base.html.twig' %}
{% block title %}{{ meuble.nom }} — SymHome{% endblock %}

{% block body %}

<div class="row g-5 align-items-start">
    <div class="col-md-5">
        {% if meuble.image %}
            <img src="{{ meuble.image }}" class="img-fluid rounded shadow-sm show-img" alt="{{ meuble.nom }}">
        {% else %}
            <div class="card-img-placeholder show-img-placeholder bg-secondary text-white rounded">
                <i class="bi bi-image fs-1"></i>
            </div>
        {% endif %}
    </div>

    <div class="col-md-7">
        <span class="badge badge-accent mb-2">
            {{ meuble.categorie ? meuble.categorie.libelle : 'Sans catégorie' }}
        </span>
        <h2 class="mb-1">{{ meuble.nom }}</h2>
        <h3 class="text-accent mb-3">{{ meuble.prix }} DT</h3>
        <p class="text-muted mb-3">{{ meuble.description }}</p>
        <div class="mb-4">
            {% if meuble.stock > 0 %}
                <span class="badge bg-success fs-6">
                    <i class="bi bi-check-circle"></i> En stock — {{ meuble.stock }} disponibles
                </span>
            {% else %}
                <span class="badge bg-danger fs-6">
                    <i class="bi bi-x-circle"></i> Rupture de stock
                </span>
            {% endif %}
        </div>
        <hr>
        <div class="d-flex gap-3 mt-4">
            {% if meuble.stock > 0 %}
                <a href="{{ path('app_panier_add', {id: meuble.id}) }}" class="btn btn-primary-custom btn-lg px-4">
                    <i class="bi bi-cart-plus"></i> Ajouter au panier
                </a>
            {% endif %}
            <a href="{{ path('app_meuble') }}" class="btn btn-outline-secondary btn-lg">← Retour</a>
        </div>
    </div>
</div>

{% endblock %}