<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Admin — SymHome{% endblock %}</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link href="{{ asset('styles/app.css') }}" rel="stylesheet">
</head>
<body class="admin-layout">

<div class="admin-sidebar">
    <div class="admin-brand">
        SymHome
        <span class="admin-badge">Admin</span>
    </div>
    <nav class="admin-nav">
        <a href="{{ path('admin_dashboard') }}"
           class="admin-nav-link {{ app.request.attributes.get('_route') == 'admin_dashboard' ? 'active' : '' }}">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>
        <a href="{{ path('admin_meuble_index') }}"
           class="admin-nav-link {{ app.request.attributes.get('_route') starts with 'admin_meuble' ? 'active' : '' }}">
            <i class="bi bi-box-seam"></i> Meubles
        </a>
        <a href="{{ path('admin_categorie_index') }}"
           class="admin-nav-link {{ app.request.attributes.get('_route') starts with 'admin_categorie' ? 'active' : '' }}">
            <i class="bi bi-tags"></i> Catégories
        </a>
        <a href="{{ path('admin_commande_index') }}"
           class="admin-nav-link {{ app.request.attributes.get('_route') starts with 'admin_commande' ? 'active' : '' }}">
            <i class="bi bi-receipt"></i> Commandes
        </a>
        <a href="{{ path('admin_user_index') }}"
           class="admin-nav-link {{ app.request.attributes.get('_route') starts with 'admin_user' ? 'active' : '' }}">
            <i class="bi bi-people"></i> Utilisateurs
        </a>
        <div class="admin-nav-divider"></div>
        <a href="{{ path('app_home') }}" class="admin-nav-link">
            <i class="bi bi-arrow-left-circle"></i> Voir le site
        </a>
        <a href="{{ path('app_logout') }}" class="admin-nav-link text-danger-soft">
            <i class="bi bi-box-arrow-right"></i> Déconnexion
        </a>
    </nav>
</div>

<div class="admin-content">
    <div class="admin-topbar">
        <div class="admin-topbar-title">{% block page_title %}{% endblock %}</div>
        <div class="admin-topbar-user">
            <i class="bi bi-person-circle"></i>
            {{ app.user ? app.user.prenom ~ ' ' ~ app.user.nom : '' }}
        </div>
    </div>

    <div class="admin-main">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'success' ? 'success' : (type == 'error' ? 'danger' : type) }} alert-dismissible fade show mb-3">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
