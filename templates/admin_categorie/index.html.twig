{% extends 'admin/base_admin.html.twig' %}

{% block title %}Catégories — Admin{% endblock %}
{% block page_title %}Gestion des Catégories{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted">{{ categories|length }} catégorie(s)</span>
    <a href="{{ path('admin_categorie_new') }}" class="btn btn-accent">
        <i class="bi bi-plus-lg me-1"></i> Ajouter une catégorie
    </a>
</div>

<div class="admin-card">
    <div class="admin-card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Libellé</th>
                    <th>Slug</th>
                    <th>Description</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for categorie in categories %}
                    <tr>
                        <td>{{ categorie.id }}</td>
                        <td class="fw-semibold">{{ categorie.libelle }}</td>
                        <td><code>{{ categorie.slug }}</code></td>
                            <td class="text-muted small">
                                {{ categorie.description|default('—')|slice(0, 60) }}{{ categorie.description|length > 60 ? '…' : '' }}
                            </td>                        
                            <td class="text-end">
                            <a href="{{ path('admin_categorie_edit', {'id': categorie.id}) }}" class="btn btn-sm btn-outline-primary me-1">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form method="post" action="{{ path('admin_categorie_delete', {'id': categorie.id}) }}" class="d-inline"
                                  onsubmit="return confirm('Supprimer cette catégorie ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ categorie.id) }}">
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="text-center text-muted py-4">Aucune catégorie.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
