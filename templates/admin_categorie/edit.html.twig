{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier {{ categorie.libelle }} — Admin{% endblock %}
{% block page_title %}Modifier : {{ categorie.libelle }}{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="admin-card">
            <div class="admin-card-header">Modifier la catégorie</div>
            <div class="admin-card-body">
                {{ form_start(form) }}
                {{ form_row(form.libelle) }}
                {{ form_row(form.slug) }}
                {{ form_row(form.description) }}
                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-accent"><i class="bi bi-check-lg me-1"></i> Enregistrer</button>
                    <a href="{{ path('admin_categorie_index') }}" class="btn btn-outline-secondary">Annuler</a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>

        <div class="mt-3">
            <form method="post" action="{{ path('admin_categorie_delete', {'id': categorie.id}) }}"
                  onsubmit="return confirm('Supprimer cette catégorie ?')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ categorie.id) }}">
                <button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash me-1"></i> Supprimer</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
