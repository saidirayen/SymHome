{% extends 'admin/base_admin.html.twig' %}

{% block title %}Nouvelle Catégorie — Admin{% endblock %}
{% block page_title %}Ajouter une Catégorie{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="admin-card">
            <div class="admin-card-header">Nouvelle catégorie</div>
            <div class="admin-card-body">
                {{ form_start(form) }}
                {{ form_row(form.libelle) }}
                {{ form_row(form.slug) }}
                {{ form_row(form.description) }}
                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-accent"><i class="bi bi-check-lg me-1"></i> Enregistrer</button>
                    <a href="{{ path('admin_categorie_index') }}" class="btn btn-outline-secondary">Annuler</a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
